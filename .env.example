# Template environment file. Copy to .env and fill in real values.
# Do not commit real secrets to the repository.

SECRET_KEY=your-secret-key
DEBUG=False
DEPLOYED=True
KEY_NAME=your_ssh_key_name
DATABASE_USER=db_user
DATABASE_NAME=db_name
DATABASE_PASS=db_password
ALLOWED_HOSTS=your-domain-or-ip
CSRF_TRUSTED_ORIGINS=https://your-domain.com
BRANCH=master
OLD_DATABASE_URL=sqlite:////home/youruser/path/to/db.sqlite3
DATABASE_URL=postgis://db_user:db_password@localhost:5432/db_name
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=your-media-bucket
AWS_BACKUP_BUCKET_NAME=your-backup-bucket
AWS_WISC_CC_STORAGE_LOCATION=your-photo-bucket
AWS_GLCCP_PHOTO_LOCATION=your-glccp-photo-bucket
AWS_S3_REGION_NAME=us-east-2
ENV=prod
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_smtp_user
EMAIL_HOST_PASSWORD=your_smtp_password
NOTIFY_EMAIL=your-email@example.com
GDU_LAMBDA_URL=https://your-lambda-url
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret
CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
